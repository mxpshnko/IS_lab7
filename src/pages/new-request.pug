- var active = ''
- var categories = ['Сантехніка', 'Електрика', 'Ліфт', 'Прибирання', 'Опалення']

include header.pug

main
	.container
		h1.page-title.page-title--center Нова заявка на ремонт

		form.request-form#request-form(action='#', method='post', novalidate)
			.field
				label.field__label(for='category') Категорія несправності
				select#category.field__control(name='category')
					option(value='') Оберіть категорію
					each category in categories
						option(value=category)= category
					p.field__error#category-error(hidden) Оберіть категорію
			
			.field
				label.field__label(for='flat') Квартира
				input#flat.field__control(type='text', name='flat', placeholder='Наприклад, 54')
				p.field__error#flat-error(hidden) Вкажіть номер квартири

			.field
				label.field__label(for='description') Опис проблеми
				textarea#description.field__control.field__control--textarea(name='description', placeholder='Опишіть проблему та вкажіть, де саме вона виникла')
				p.field__error#description-error(hidden) Опишіть проблему

			.field
				span.field__label Додати фото
				label.upload(for='photos')
					input#photos.upload__input(type='file', name='photos', accept='image/png, image/jpeg', multiple)
					span.upload__plus +
					span.upload__title Додати фото
					span.upload__hint JPG або PNG, до 5 МБ, не більше 5 файлів
				p.field__error#photos-error(hidden)
				ul.previews#previews

			.request-form__actions
				button.btn-orange(type='submit') Надіслати
				a.btn-outline(href='my-requests.html') Скасувати

include footer.pug